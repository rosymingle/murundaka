---

export const prerender = true;

// 1. Scan the directory and pull all pages managed by the CMS
const allPageFiles = import.meta.glob('../content/pages/*.md', { eager: true });

// 2. Fetch the Global Configuration data for the header/footer
const globalFiles = import.meta.glob('../content/global/settings.json', { eager: true });
const globalData: any = Object.values(globalFiles)[0];
const { header, footer } = globalData.default;

// 3. Generate routes for every single file in the pages directory
export async function getStaticPaths() {
  const pages = import.meta.glob('../content/pages/*.md', { eager: true });
  
  return Object.entries(pages).map(([filePath, fileData]: [string, any]) => {
    const fileName = filePath.split('/').pop()?.replace('.md', '') || '';
    return {
      params: { slug: fileName }, // This maps the URL path (e.g., /about)
      props: { fileData }         // This passes the markdown content down
    };
  });
}

// 4. Retrieve the parameters from the active URL slug
const { slug } = Astro.params;
const { fileData } = Astro.props;

// 5. Setup the Navigation Tree (Exactly the same logic as the homepage)
const flatPages = Object.entries(allPageFiles).map(([filePath, data]: [string, any]) => {
  const fileName = filePath.split('/').pop()?.replace('.md', '') || '';
  return {
    label: data.frontmatter.title || fileName,
    url: fileName === 'home' ? '/' : `/${fileName}`,
    order: data.frontmatter.menuOrder ?? 99,
    parent: data.frontmatter.parentMenu || null
  };
});

const navMenu: any[] = [];
flatPages.filter(p => !p.parent).sort((a, b) => a.order - b.order).forEach(parent => {
  navMenu.push({ ...parent, children: [] });
});
flatPages.forEach(page => {
  if (page.parent) {
    const parentMenu = navMenu.find(p => p.label.toLowerCase() === page.parent.toLowerCase());
    if (parentMenu) parentMenu.children.push(page);
  }
});
navMenu.forEach(p => p.children.sort((a: any, b: any) => a.order - b.order));

// 6. Extract page-specific body text
const { heroTitle, heroTagline } = fileData.frontmatter;
const Content = fileData.Content;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="/uploads/favicon.png">
		<title>{header.siteName} - {heroTagline}</title>
		<link rel="stylesheet" href="https://rosydb.com.au/eaCSSv5/ea.css">
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Mountains+of+Christmas:wght@400;700&display=swap" rel="stylesheet">
		<style is:global>
			body { margin: 0 !important; padding: 0!important; }
			h1, h2, h3, h4, h5, h6 {
 				font-family: "Mountains of Christmas", serif;
			  	font-weight: 600 !important;
			  	font-style: normal;
			}
			.tbbg { background-image: url('/uploads/hero1.avif'); }
			/* Pure CSS Dropdown Navigation */
			.nav-bar {
				padding: 0;
				display: flex;
				justify-content: center;
				list-style: none;
				margin: 0;
				box-shadow: 0 10px 10px rgba(0, 0, 0, .2);
			}
			.menu-item {
				position: relative;
				padding: 0;
			}
			.menu-item a {
				text-decoration: none;
				color: #2e4a3f;
				font-weight: 600;
				padding: 12px 15px;
				display: block;
			}
			.menu-item:first-child > a {
				border-radius: 7px 0 0 7px;
			}
			.menu-item:last-child > a {
				border-radius: 0 7px 7px 0;
			}
			.menu-item a:hover, .menu-item:hover > a {
				background: #e9f0ec;
			}

			/* Dropdown Panel */
			.dropdown {
				position: absolute;
				top: 100%;
				left: 0;
				background: white;
				border: 1px solid #e9f0ec;
				list-style: none;
				padding: 0;
				width: 155px;
				display: none; /* Hide by default */
				z-index: 10;
			}
			.dropdown li {
				padding: 0px;
				text-align: left;
			}
			.dropdown a {
				font-weight: 400;
			}
			
			/* Trigger dropdown on hover */
			.menu-item:hover .dropdown {
				display: block;
			}
		</style>
	</head>
	<body class="eacss">
		<div>
			<div class="helvetica smooth t-align-c">
				<header class="pos-r">
					<div class="tbbg bg-pos-c bg-size-cover h-300 brdr-b-1 brdr-grey-d">
						<nav class="wrapper-1050 pos-s pad-10 z-1">
							<ul class="nav-bar bg-white brad-7 float-r">
								{navMenu.map((item) => (
									<li class="menu-item">
										<a href={item.url}>{item.label}</a>
										
										{item.children.length > 0 && (
											<ul class="dropdown">
												{item.children.map((child: any) => (
													<li>
														<a href={child.url}>{child.label}</a>
													</li>
												))}
											</ul>
										)}
									</li>
								))}
							</ul>
						</nav>
					</div>
					<h1 class="fs-50p pos-a-center white" style="text-shadow: 0 5px 5px rgba(0,0,0,.5);">{heroTitle}</h1>
					<div class="wrapper-1050 mrgn-t-n120 m-mrgn-t-n90 cf pos-r">
						<a href="/" class="disp-bl float-l" title={`${header.siteName}`}><img class="wrapper-300 mrgn-b-n50 m-wrapper-220" src="/uploads/md-logo-treee.png"></a>
						<h4 class="fw-1 pos-a-br m-mrgn-b-0 mrgn-r-15 italic" style="color: #7e9a8f;">We are Earth</h4>
					</div>
				</header>
				<main class="container pad-tb-60 pad-lr-20" style="min-height: calc(100vh - 286px);">
					<div class="wrapper-1000 t-align-l pagecontent">
						<Content />
					</div>
				</main>
				<footer class="pad-30 brdr-t-1 brdr-grey-d bg-grey-f5">
					<div class="wrapper-1000">
						<div class="flex flex-jc-spbt m-unflex">
							<p class="flex mrgn-b-0" style="column-gap: 5px;">
								<a class="" href="mailto:info@murundakacohousing.org.au"><img class="wrapper-30 disp-il" src="/uploads/mail.png" /></a> 
								<a class="" href="https://www.facebook.com/Murundaka" target="_blank"><img class="wrapper-30 disp-il" src="/uploads/facebook.png" /></a> 
								<a class="" href="https://www.youtube.com/@murundakacohousingcommunti4467" target="_blank"><img class="wrapper-30 disp-il" src="/uploads/youtube.png" /></a>
							</p>
							<p class="fs-11 grey-9 mrgn-b-0 m-mrgn-t-20">&copy; Earth CERC</p>
						</div>
					</div>
				</footer>
			</div>
		</div>
	</body>
</html>
